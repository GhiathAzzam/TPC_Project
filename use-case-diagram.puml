@startuml Manufacturing Management System - Use Case Diagram

left to right direction

' Define actors
actor "Admin" as admin
actor "Accountant" as accountant
actor "Warehouse Keeper" as warehouse
actor "System" as system

' Define use case packages
package "User Management" {
    usecase "Register Users" as UC1
    usecase "Manage User Accounts" as UC2
    usecase "Change User Activation" as UC3
    usecase "View Activity Logs" as UC4
}

package "Authentication" {
    usecase "Login" as UC5
    usecase "Logout" as UC6
    usecase "Update Profile" as UC7
}

package "Material Management" {
    usecase "Manage Raw Materials" as UC8
    usecase "Manage Raw Material Batches" as UC9
    usecase "Track Damaged Materials" as UC10
    usecase "Search Materials" as UC11
}

package "Product Management" {
    usecase "Manage Products" as UC12
    usecase "Manage Product Batches" as UC13
    usecase "Define Product Materials (BOM)" as UC14
    usecase "Convert Materials to Products" as UC15
    usecase "Update Product Prices" as UC16
}

package "Financial Management" {
    usecase "Manage Expenses" as UC17
    usecase "Manage Expense Categories" as UC18
    usecase "Record Product Sales" as UC19
    usecase "Manage Production Settings" as UC20
}

package "Reporting" {
    usecase "Generate Profit/Loss Reports" as UC21
    usecase "Generate Product Summary Reports" as UC22
    usecase "View Monthly Sales" as UC23
    usecase "Refresh Reports" as UC24
}

package "Notifications" {
    usecase "View Notifications" as UC25
    usecase "Mark Notifications as Read" as UC26
}

package "System Operations" {
    usecase "Log Activities" as UC27
    usecase "Send Notifications" as UC28
    usecase "Generate Reports" as UC29
}

