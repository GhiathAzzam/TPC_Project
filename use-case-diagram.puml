@startuml Manufacturing Management System - Use Case Diagram

!theme plain
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #E8F4FD
skinparam actorBackgroundColor #F0F8FF
skinparam packageBackgroundColor #F5F5F5
skinparam roundcorner 10

title Manufacturing Management System - Use Case Diagram

' Define actors with better positioning
actor "Admin" as admin #FFE4B5
actor "Accountant" as accountant #E6FFE6
actor "Warehouse Keeper" as warehouse #FFE6E6
actor "System" as system #E6E6FA

' Core System Packages with logical grouping
package "👤 User & Authentication" as UserAuth #F0F8FF {
    usecase "Register Users" as UC1
    usecase "Login/Logout" as UC5
    usecase "Update Profile" as UC7
    usecase "Manage User Accounts" as UC2
    usecase "Change User Activation" as UC3
    usecase "View Activity Logs" as UC4
}

package "📦 Inventory Management" as Inventory #F0FFF0 {
    usecase "Manage Raw Materials" as UC8
    usecase "Manage Raw Material Batches" as UC9
    usecase "Search Materials" as UC11
    usecase "Track Damaged Materials" as UC10
}

package "🏭 Production Management" as Production #FFF8F0 {
    usecase "Manage Products" as UC12
    usecase "Manage Product Batches" as UC13
    usecase "Define Product Materials (BOM)" as UC14
    usecase "Convert Materials to Products" as UC15
    usecase "Update Product Prices" as UC16
}

package "💰 Financial Operations" as Financial #FFF0F8 {
    usecase "Manage Expenses" as UC17
    usecase "Manage Expense Categories" as UC18
    usecase "Record Product Sales" as UC19
    usecase "Manage Production Settings" as UC20
}

package "📊 Reporting & Analytics" as Reporting #F8F0FF {
    usecase "Generate Profit/Loss Reports" as UC21
    usecase "Generate Product Summary Reports" as UC22
    usecase "View Monthly Sales" as UC23
    usecase "Refresh Reports" as UC24
}

package "🔔 Notifications" as Notifications #F0F0F0 {
    usecase "View Notifications" as UC25
    usecase "Mark Notifications as Read" as UC26
}

package "⚙️ System Operations" as SystemOps #F5F5F5 {
    usecase "Log Activities" as UC27
    usecase "Send Notifications" as UC28
    usecase "Generate Reports" as UC29
}

' Admin relationships (full access)
admin -down-> UC1
admin -down-> UC2
admin -down-> UC3
admin -down-> UC4
admin -down-> UC5
admin -down-> UC7

admin -right-> UC8
admin -right-> UC9
admin -right-> UC10
admin -right-> UC11

admin -right-> UC12
admin -right-> UC13
admin -right-> UC14
admin -right-> UC15
admin -right-> UC16

admin -down-> UC17
admin -down-> UC18
admin -down-> UC19
admin -down-> UC20

admin -down-> UC21
admin -down-> UC22
admin -down-> UC23
admin -down-> UC24

admin -right-> UC25
admin -right-> UC26

' Accountant relationships (financial focus)
accountant -up-> UC5
accountant -up-> UC7

accountant -up-> UC17
accountant -up-> UC18
accountant -up-> UC19
accountant -up-> UC20

accountant -up-> UC21
accountant -up-> UC22
accountant -up-> UC23
accountant -up-> UC24

accountant -right-> UC25
accountant -right-> UC26

' Warehouse Keeper relationships (inventory/production focus)
warehouse -up-> UC5
warehouse -up-> UC7

warehouse -up-> UC8
warehouse -up-> UC9
warehouse -up-> UC10
warehouse -up-> UC11

warehouse -up-> UC12
warehouse -up-> UC13
warehouse -up-> UC14
warehouse -up-> UC15
warehouse -up-> UC16

warehouse -right-> UC25
warehouse -right-> UC26

' System relationships (automated processes)
system -up-> UC27
system -up-> UC28
system -up-> UC29

' Include relationships with better visual flow
UC8 .down.> UC11 : <<include>>
UC12 .down.> UC11 : <<include>>
UC19 .down.> UC21 : <<include>>
UC19 .down.> UC22 : <<include>>
UC21 .down.> UC29 : <<include>>
UC22 .down.> UC29 : <<include>>

' Activity logging includes
UC1 .down.> UC27 : <<include>>
UC2 .down.> UC27 : <<include>>
UC8 .down.> UC27 : <<include>>
UC12 .down.> UC27 : <<include>>
UC17 .down.> UC27 : <<include>>
UC19 .down.> UC27 : <<include>>

' Extend relationships
UC24 .up.> UC22 : <<extend>>
UC26 .up.> UC25 : <<extend>>
UC16 .up.> UC12 : <<extend>>

' Notification trigger
UC27 .right.> UC28 : <<trigger>>

' Layout positioning hints
UserAuth -down[hidden]-> Financial
Inventory -down[hidden]-> Reporting
Production -down[hidden]-> Notifications
Financial -down[hidden]-> SystemOps

' Notes with better positioning
note top of UC4 : "Admin exclusive:\nMonitor all user activities"
note right of UC15 : "Core Process:\nRaw materials → Products"
note bottom of UC21 : "Auto-calculated from\nsales and expenses"
note left of UC27 : "Automatic logging of\nall system activities"

@enduml